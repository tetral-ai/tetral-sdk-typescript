#!/usr/bin/env bash

set -euxo pipefail

./scripts/build
cd dist

# Get package name and version from package.json
PACKAGE_NAME="$(jq -r -e '.name' ./package.json)"
VERSION="$(jq -r -e '.version' ./package.json)"

if [[ "$PACKAGE_NAME" != "@tetral-ai/sdk" ]]; then
  echo "ERROR: refusing to publish unexpected package $PACKAGE_NAME" >&2
  exit 1
fi

# Publish prereleases under their explicit channel. npm may also initialize
# `latest` to the first published version until a stable release replaces it.
if [[ "$VERSION" =~ -([a-zA-Z][a-zA-Z0-9-]*) ]]; then
  TAG="${BASH_REMATCH[1]}"
else
  TAG="latest"
fi

export npm_config_registry='https://registry.npmjs.org'
npm publish --access public --tag "$TAG"
